{
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "enum": [
            "compact-v2"
          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": [
            "context_request"
          ]
        },
        "requests": {
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "range"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "side": {
                    "type": "string",
                    "enum": [
                      "LEFT",
                      "RIGHT"
                    ]
                  },
                  "start": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "side",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "search"
                    ]
                  },
                  "literal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "side": {
                    "type": "string",
                    "enum": [
                      "LEFT",
                      "RIGHT"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "literal",
                  "side"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "kind",
        "requests"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "enum": [
            "compact-v2"
          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": [
            "result"
          ]
        },
        "reviewedIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "id",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "classification": {
                "type": "string",
                "enum": [
                  "introduced_failure",
                  "existing_issue",
                  "improvement",
                  "preference",
                  "insufficient_evidence"
                ],
                "description": "Classify the causal claim. Only introduced_failure is publishable. Cosmetic changes, preferences and descriptions of fixes are not introduced failures."
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "changedBehavior": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "description": "Specific BEFORE versus AFTER behavior. Describe what the PR changes, not an imagined implementation."
              },
              "trigger": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "description": "Concrete supported input or situation that makes the NEW code fail. Merely rendering a changed component is not a failing trigger."
              },
              "consequence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "description": "Incorrect behavior caused by the NEW code under the trigger, and why it violates a supported requirement. A smaller font, more badges, or an overlay preventing races is not itself a failure. Do not describe what would fail WITHOUT the fix."
              },
              "introducedByAtomIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "evidenceIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "anchor": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "side": {
                        "type": "string",
                        "enum": [
                          "LEFT",
                          "RIGHT"
                        ]
                      },
                      "line": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "path",
                      "side",
                      "line"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "classification",
              "severity",
              "title",
              "changedBehavior",
              "trigger",
              "consequence",
              "introducedByAtomIds",
              "evidenceIds",
              "anchor"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "kind",
        "reviewedIds",
        "unresolved",
        "findings"
      ],
      "additionalProperties": false
    }
  ]
}
